# 複製為 .env 後依需要調整;docker compose 會自動讀取
COMPOSE_PROJECT_NAME=erp

POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp

# 對外(本機)埠號;避開 ~/www 其他專案已占用的 5432 / 8080 / 5173
POSTGRES_PORT=15432
API_PORT=18080
WEB_PORT=15173

APP_ENV=development

# 正式環境經 nginx 代理時,填 nginx 容器所在網段(例:172.16.0.0/12),否則留空
TRUSTED_PROXIES=
