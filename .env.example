# 複製為 .env 後依需要調整;docker compose 會自動讀取
COMPOSE_PROJECT_NAME=erp

POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp

# 對外(本機)埠號;避開 ~/www 其他專案已占用的 5432 / 8080 / 5173
POSTGRES_PORT=15432
API_PORT=18080
WEB_PORT=15173

APP_ENV=development

# 可信任的反向代理(IP/CIDR,逗號分隔)。
# 正式環境經 nginx 代理時「務必」填 nginx 所在網段(例:172.16.0.0/12),
# 否則後端看到的來源 IP 全是 nginx,登入/刷新的限流(以 IP 計算)會變成全公司共用。
TRUSTED_PROXIES=

# JWT 簽章密鑰(至少 32 字元)。正式環境務必換成隨機值:openssl rand -base64 48
# 含 "dev-only" 字樣的密鑰在 APP_ENV=production 時會拒絕啟動
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# 限流(每分鐘次數):已登入的 API 以「使用者」計算;登入、刷新尚未登入,以「IP」計算(IPv6 以 /64 計)
# 公司共用對外 IP 時,登入/刷新額度由全公司共用,人數多請調高
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=60
REFRESH_RATE_LIMIT_PER_MINUTE=300
