# 正式環境設定:複製為 .env.prod(已被 .gitignore 排除,不要提交),全部改成自己的值。
# 啟動:docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=erp
# 長隨機密碼:openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=erp

# JWT 簽章密鑰(至少 32 字元,含 "dev-only" 字樣會拒絕啟動):openssl rand -base64 48
# 換掉密鑰會讓所有人被登出,不會損毀資料
JWT_SECRET=CHANGE_ME

# 信任的反向代理網段(逗號分隔)。含 compose 內部網段 172.28.0.0/24(nginx);
# 若前面還有 TLS 代理(Caddy 等),把它的 IP / 網段也加進來,例如 172.28.0.0/24,10.0.0.5
# 沒設對的話,登入 / 刷新限流(以來源 IP 計算)會把全公司當成同一個人
TRUSTED_PROXIES=172.28.0.0/24

# 對外埠。預設只聽本機(127.0.0.1),由前面的 TLS 代理轉進來
WEB_BIND=127.0.0.1
WEB_PORT=8080

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# 限流(每分鐘次數):已登入 API 以使用者計;登入、刷新以 IP 計。公司共用對外 IP 且人數多時請調高 LOGIN / REFRESH
RATE_LIMIT_PER_MINUTE=600
LOGIN_RATE_LIMIT_PER_MINUTE=120
REFRESH_RATE_LIMIT_PER_MINUTE=600

# 只在執行 create-admin 時才需要(用完請清空),避免密碼留在檔案裡
ADMIN_PASSWORD=
